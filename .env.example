SECRET_KEY=
DEBUG=False

ALLOWED_HOSTS=your-domain.example,www.your-domain.example
CSRF_TRUSTED_ORIGINS=https://your-domain.example,https://www.your-domain.example

DATABASE_NAME=partonoor
DATABASE_USER=partonoor
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5432

STATIC_URL=/static/
STATIC_ROOT=/var/www/partonoor/staticfiles
MEDIA_URL=/media/
MEDIA_ROOT=/var/www/partonoor/media

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
CONSULTATION_NOTIFY_EMAIL=

LOG_FILE=/var/www/partonoor/logs/partonoor.log

# Public https base URL (canonical, sitemap, robots, JSON-LD)
SITE_URL=https://your-domain.example
